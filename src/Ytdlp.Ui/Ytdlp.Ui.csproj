<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <NpmCommand Condition="'$(NpmCommand)' == ''">npm</NpmCommand>
    <BuildFrontend Condition="'$(BuildFrontend)' == ''">false</BuildFrontend>
    <ClientAppDirectory>$(MSBuildProjectDirectory)/../Ytdlp.Ui.Client/</ClientAppDirectory>
    <FrontendOutputDirectory>$(ClientAppDirectory)dist/</FrontendOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <Target Name="RestoreFrontendPackages"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(ClientAppDirectory)package.json;$(ClientAppDirectory)package-lock.json"
          Outputs="$(ClientAppDirectory)node_modules/.install-stamp">
    <Exec WorkingDirectory="$(ClientAppDirectory)" Command="$(NpmCommand) ci --no-audit --no-fund" />
    <Touch Files="$(ClientAppDirectory)node_modules/.install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildFrontend"
          DependsOnTargets="RestoreFrontendPackages"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Exec WorkingDirectory="$(ClientAppDirectory)" Command="$(NpmCommand) run build" />
  </Target>

  <Target Name="BuildFrontendIfRequested" BeforeTargets="PrepareForBuild"
          DependsOnTargets="BuildFrontend"
          Condition="'$(BuildFrontend)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'" />

  <Target Name="CollectFrontendContent" BeforeTargets="AssignTargetPaths;ResolveProjectStaticWebAssets"
          DependsOnTargets="BuildFrontendIfRequested" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_FrontendFile Include="$(FrontendOutputDirectory)**/*" />
      <Content Include="@(_FrontendFile)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
        <Link>wwwroot/%(_FrontendFile.RecursiveDir)%(_FrontendFile.Filename)%(_FrontendFile.Extension)</Link>
        <ContentRoot>$(FrontendOutputDirectory)</ContentRoot>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="ValidateFrontendForPublish" BeforeTargets="PrepareForPublish"
          DependsOnTargets="BuildFrontendIfRequested">
    <Error Condition="!Exists('$(FrontendOutputDirectory)index.html')"
           Text="React build is missing. Run npm ci and npm run build in src/Ytdlp.Ui.Client before building/publishing, or use -p:BuildFrontend=true (without --no-build)." />
  </Target>
</Project>
