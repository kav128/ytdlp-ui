<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <NpmCommand Condition="'$(NpmCommand)' == ''">npm</NpmCommand>
    <ClientAppDirectory>$(MSBuildProjectDirectory)/ClientApp/</ClientAppDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/node_modules/**" />
  </ItemGroup>

  <Target Name="RestoreFrontendPackages"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(ClientAppDirectory)package.json;$(ClientAppDirectory)package-lock.json"
          Outputs="$(ClientAppDirectory)node_modules/.install-stamp">
    <Exec WorkingDirectory="$(ClientAppDirectory)" Command="$(NpmCommand) ci --no-audit --no-fund" />
    <Touch Files="$(ClientAppDirectory)node_modules/.install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild"
          DependsOnTargets="RestoreFrontendPackages"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Exec WorkingDirectory="$(ClientAppDirectory)" Command="$(NpmCommand) run build" />
  </Target>

  <Target Name="CollectFrontendContent" BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildFrontend" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Content Remove="wwwroot/**" />
      <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')"
           Text="React build is missing. Run dotnet build before publishing with --no-build." />
  </Target>
</Project>
